# 이 파일은 템플릿입니다(키 넣지 마세요). 복사해서 .env 를 만들고 거기에 값을 채우세요.
#   Windows:  copy .env.example .env
#   Mac/Linux: cp .env.example .env
# .env 는 .gitignore 로 제외되어 git에 올라가지 않습니다.

# 공공데이터포털 인증키 (청약홈 + 실거래가). Decoding 키 권장.
DATA_GO_KR_KEY=
# 실거래가용 키가 다르면 입력(같으면 비워두기 → 위 키 재사용)
REALPRICE_KEY=

# 카카오
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REFRESH_TOKEN=
KAKAO_REDIRECT_URI=https://localhost:5000/oauth

# 발송 없이 콘솔 확인만 하려면 1
DRY_RUN=1
